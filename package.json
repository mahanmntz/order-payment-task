{
  "name": "order-payment-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db": "ts-node-dev --transpile-only src/dev-db.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "web": "npm --prefix web run dev",
    "reset": "ts-node --transpile-only src/reset.ts",
    "demo": "bash scripts/demo.sh"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 60000
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}